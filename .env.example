# --- Required -------------------------------------------------------------
# openai | anthropic | openrouter
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Password the fake system accepts for `su` / root.
ROOT_PASSWORD=

# --- Optional -------------------------------------------------------------
# If set, required for SSH login as admin and for sudo prompts.
# If empty, any password is accepted for both.
ADMIN_PASSWORD=
# Empty = provider default (anthropic: claude-opus-5-5, openai: gpt-5-mini,
# openrouter: openai/gpt-5-mini)
LLM_MODEL=

LISTEN_HOST=0.0.0.0
LISTEN_PORT=2222
DATA_DIR=./data
LOG_DIR=./logs
HONEYPOT_HOSTNAME=srv-prod-01

MAX_SESSIONS=10
MAX_COMMANDS=200
IDLE_TIMEOUT=600
LLM_TIMEOUT=30
HISTORY_TURNS=30
LOG_LEVEL=INFO
